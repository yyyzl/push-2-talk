{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --python 3.12 python -X utf8 .claude/hooks/session-start.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --python 3.12 python -X utf8 .claude/hooks/session-start.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --python 3.12 python -X utf8 .claude/hooks/session-start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --python 3.12 python -X utf8 .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --python 3.12 python -X utf8 .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/10455/AppData/Roaming/npm/node_modules/gitnexus/hooks/claude/gitnexus-hook.cjs",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --python 3.12 python -X utf8 .claude/hooks/inject-workflow-state.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jcodemunch-mcp hook-precompact"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jcodemunch-mcp hook-posttooluse"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/10455/AppData/Roaming/npm/node_modules/gitnexus/hooks/claude/gitnexus-hook.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Grep",
      "Glob",
      "LS",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "TodoRead",
      "TodoWrite",
      "mcp__sequential-thinking__*",
      "mcp__context7__*",
      "mcp__chrome-devtools__*",
      "mcp__ace-tool__*",
      "mcp__acemcp__*",
      "mcp__contextweaver__*",
      "mcp__gitnexus__*",
      "mcp__jcodemunch__*"
    ],
    "deny": [],
    "ask": []
  },
  "defaultMode": "bypassPermissions"
}
